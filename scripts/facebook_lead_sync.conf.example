# Copy this file to facebook_lead_sync.conf on the Oracle server.
# Fill the blanks there. Do not commit the filled file. Do not email it.

[odoo]
# Address that works on the server itself. This is usually local.
url = http://193.123.76.128
database = sygmetiv_db
username = admin
# Odoo API key. This is not the login password.
api_key = 2934c2d428032237e6181637dde44a4725919764

[facebook]
# Version shown in the Graph API Explorer dropdown, for example v25.0
graph_version = v26.0
page_id = 967880653078908
# Leave form_id blank. Every form on the Page is fetched, including a form created later.
form_id =
page_token = EAASwBr71ne4BSwZBpvSIH2j4NihSnAUakkXNJhWgFLJXtfRgXo6Qwg1NevSvuM6cT86AVLJILNZCUhhaf7HQ8QWbYHQDjVferYr8ZBiy4HZC0C5E8G7rTXvupn5Id8Hhakm6wO8idocCnS39pgZC6VHCijhZCC5VqZCgRusO0
# Import leads submitted on or after this date.
since = 2026-10-20

[lead]
title_prefix = FB Demo –
source_line = Source: Facebook Ads – HR software demo
# Team for every form that is not listed under [forms], including new forms.
# Use the exact name from CRM → Configuration → Sales Teams.
sales_team =

[forms]
# Two forms go to one team. Repeat the team name on each line.
# 111111111111111 = HR Demo Team
# 222222222222222 = HR Demo Team
# Every other form on the Page uses sales_team above.
