<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_sale_approval_request" model="mail.template">
            <field name="name">Sales: Approval Request</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} - Quotation to approve ({{ object.name }})</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>
        Quotation <strong t-out="object.name or ''"/> for
        <t t-out="object.partner_id.display_name or ''"/>
        (<t t-out="format_amount(object.amount_total, object.currency_id) or ''"/>)
        is waiting for your approval.
    </p>
    <p>
        Requested by
        <t t-out="object.approval_requested_by.display_name or object.env.user.display_name"/>.
    </p>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/odoo/sale.order/{{ object.id }}">Open quotation</a>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_sale_approval_done" model="mail.template">
            <field name="name">Sales: Quotation Approved</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} - Quotation approved ({{ object.name }})</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>
        Quotation <strong t-out="object.name or ''"/> has been approved by
        <t t-out="object.approved_by.display_name or ''"/> and confirmed as a sales order.
    </p>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/odoo/sale.order/{{ object.id }}">Open sales order</a>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_sale_approval_rejected" model="mail.template">
            <field name="name">Sales: Quotation Rejected</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">{{ object.company_id.name }} - Quotation rejected ({{ object.name }})</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="body_html" type="html">
<div>
    <p>Hello,</p>
    <p>
        Quotation <strong t-out="object.name or ''"/> was rejected and set back to quotation.
    </p>
    <p>
        <a t-attf-href="{{ object.get_base_url() }}/odoo/sale.order/{{ object.id }}">Open quotation</a>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
