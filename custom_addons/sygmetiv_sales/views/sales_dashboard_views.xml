<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_sales_dashboard_form" model="ir.ui.view">
        <field name="name">syg.sales.dashboard.form</field>
        <field name="model">syg.sales.dashboard</field>
        <field name="arch" type="xml">
            <form string="Sales Dashboard" create="0" delete="0" class="o_syg_dashboard o_syg_dashboard_sales">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="name" invisible="1"/>
                    <div class="o_syg_dash_hero">
                        <div class="o_syg_dash_hero_copy">
                            <div class="o_syg_dash_kicker">Sygmetiv · Sales</div>
                            <h1>Company sales dashboard</h1>
                            <div class="o_syg_dash_subtitle">Leads, pipeline and confirmed sales for this company</div>
                        </div>
                        <div class="o_syg_dash_hero_actions">
                            <div class="o_syg_period_pill">
                                <i class="fa fa-calendar"/>
                                <field name="period_start" widget="daterange" options="{'end_date_field': 'period_end'}" nolabel="1"/>
                                <field name="period_end" invisible="1"/>
                            </div>
                            <button name="action_refresh" type="object" string="Refresh" class="btn btn-light o_syg_btn_ghost"/>
                        </div>
                    </div>
                    <div class="o_syg_section_title">Leads and pipeline</div>
                    <div class="o_syg_kpi_grid">
                        <button name="action_open_leads" type="object" class="o_syg_kpi_card o_syg_accent_sky">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-bullseye"/></span><span class="o_syg_kpi_label">New leads</span></div>
                            <div class="o_syg_kpi_value"><field name="d_leads" nolabel="1" readonly="1"/></div>
                        </button>
                        <button name="action_open_opportunities" type="object" class="o_syg_kpi_card o_syg_accent_violet">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-handshake-o"/></span><span class="o_syg_kpi_label">Opportunities</span></div>
                            <div class="o_syg_kpi_value"><field name="d_opportunities" nolabel="1" readonly="1"/></div>
                        </button>
                        <div class="o_syg_kpi_card o_syg_accent_green o_syg_kpi_static">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-trophy"/></span><span class="o_syg_kpi_label">Won</span></div>
                            <div class="o_syg_kpi_value"><field name="d_won" nolabel="1" readonly="1"/></div>
                        </div>
                        <div class="o_syg_kpi_card o_syg_accent_rose o_syg_kpi_static">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-times-circle"/></span><span class="o_syg_kpi_label">Lost</span></div>
                            <div class="o_syg_kpi_value"><field name="d_lost" nolabel="1" readonly="1"/></div>
                        </div>
                        <div class="o_syg_kpi_card o_syg_accent_amber o_syg_kpi_static">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-line-chart"/></span><span class="o_syg_kpi_label">Pipeline</span></div>
                            <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_pipeline" nolabel="1" readonly="1"/></div>
                        </div>
                    </div>
                    <div class="o_syg_section_title">Company sales</div>
                    <div class="o_syg_kpi_grid">
                        <button name="action_open_quotations" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-file-text-o"/></span><span class="o_syg_kpi_label">Quotations</span></div>
                            <div class="o_syg_kpi_value"><field name="d_quotations" nolabel="1" readonly="1"/></div>
                        </button>
                        <div class="o_syg_kpi_card o_syg_accent_sky o_syg_kpi_static">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-money"/></span><span class="o_syg_kpi_label">Quotation amount</span></div>
                            <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_quotation_amt" nolabel="1" readonly="1"/></div>
                        </div>
                        <button name="action_open_orders" type="object" class="o_syg_kpi_card o_syg_accent_green">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-shopping-cart"/></span><span class="o_syg_kpi_label">Sales orders</span></div>
                            <div class="o_syg_kpi_value"><field name="d_orders" nolabel="1" readonly="1"/></div>
                        </button>
                        <div class="o_syg_kpi_card o_syg_accent_violet o_syg_kpi_static">
                            <div class="o_syg_kpi_top"><span class="o_syg_kpi_icon"><i class="fa fa-bank"/></span><span class="o_syg_kpi_label">Confirmed sales</span></div>
                            <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_sales" nolabel="1" readonly="1"/></div>
                        </div>
                    </div>
                    <div class="o_syg_section_title">Graphs</div>
                    <div class="o_syg_chart_grid">
                        <div class="o_syg_chart_card">
                            <div class="o_syg_kpi_label">New leads vs opportunities</div>
                            <field name="graph_leads" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                        </div>
                        <div class="o_syg_chart_card">
                            <div class="o_syg_kpi_label">Pipeline by stage</div>
                            <field name="graph_pipeline" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                        </div>
                        <div class="o_syg_chart_card">
                            <div class="o_syg_kpi_label">Confirmed sales (6 months)</div>
                            <field name="graph_sales" widget="syg_dashboard_graph" options="{'graph_type': 'line'}" nolabel="1"/>
                        </div>
                    </div>
                    <div class="o_syg_chart_grid">
                        <div class="o_syg_chart_card">
                            <div class="o_syg_kpi_label">Company mix</div>
                            <field name="graph_mix" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_syg_sales_dashboard" model="ir.actions.server">
        <field name="name">Sales Dashboard</field>
        <field name="model_id" ref="model_syg_sales_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
