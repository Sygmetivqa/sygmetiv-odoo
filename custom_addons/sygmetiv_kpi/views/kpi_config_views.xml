<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_kpi_evaluation_config_list" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.config.list</field>
        <field name="model">syg.kpi.evaluation.config</field>
        <field name="arch" type="xml">
            <list string="KPI Evaluations">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="evaluation_type"/>
                <field name="grace_days"/>
                <field name="evaluation_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_syg_kpi_evaluation_config_form" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.config.form</field>
        <field name="model">syg.kpi.evaluation.config</field>
        <field name="arch" type="xml">
            <form string="KPI Evaluation">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_evaluations" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="evaluation_count" widget="statinfo" string="Periods"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="evaluation_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="grace_days" readonly="state != 'draft'"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="state != 'draft'">
                        Submit this evaluation for the employee. A period record is created for the last completed week, month, or year, and later periods are created automatically. Evaluators get an email with a link to enter scores. No Done step is required.
                    </div>
                    <notebook>
                        <page string="Evaluators">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="criteria_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_syg_kpi_evaluation_config_search" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.config.search</field>
        <field name="model">syg.kpi.evaluation.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="evaluation_type"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'evaluation_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_syg_kpi_evaluation_config" model="ir.actions.act_window">
        <field name="name">KPI Evaluations</field>
        <field name="res_model">syg.kpi.evaluation.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
