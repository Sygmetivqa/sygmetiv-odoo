<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_score_page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>KPI Evaluation</title>
                <style>
                    body { font-family: Arial, sans-serif; background: #f6f3f5; color: #1f1724; margin: 0; }
                    .wrap { max-width: 860px; margin: 32px auto; padding: 0 16px; }
                    .card { background: #fff; border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: 0 8px 24px rgba(28,12,42,.06); }
                    h1 { font-size: 1.4rem; margin: 0 0 8px; }
                    table { width: 100%; border-collapse: collapse; }
                    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; vertical-align: top; }
                    input[type="number"] { width: 110px; padding: 6px 8px; }
                    .btn { background: #714b67; color: #fff; border: 0; border-radius: 6px; padding: 10px 18px; font-weight: 700; cursor: pointer; }
                    .muted { color: #6b6170; }
                    .badge { display: inline-block; background: #f3e8ff; color: #6b21a8; border-radius: 999px; padding: 2px 8px; font-size: 12px; margin-left: 8px; }
                </style>
            </head>
            <body>
                <div class="wrap">
                    <t t-out="0"/>
                </div>
            </body>
        </html>
    </template>

    <template id="portal_score_no_token" name="KPI Score - No Token">
        <t t-call="sygmetiv_kpi.portal_score_page">
            <div class="card">
                <h1>KPI evaluation</h1>
                <p>Use the link from your evaluation email to enter scores.</p>
            </div>
        </t>
    </template>

    <template id="portal_score_invalid_token" name="KPI Score - Invalid Token">
        <t t-call="sygmetiv_kpi.portal_score_page">
            <div class="card">
                <h1>KPI evaluation</h1>
                <p>This link is not valid. Ask HR to send a new evaluation email.</p>
            </div>
        </t>
    </template>

    <template id="portal_score_form" name="KPI Score - Entry Form">
        <t t-call="sygmetiv_kpi.portal_score_page">
            <div class="card">
                <h1>Enter KPI scores</h1>
                <p class="muted">Hello <t t-esc="access.user_id.name"/>. Enter a score for each criteria assigned to you.</p>
            </div>
            <form method="post" action="/kpi/score/submit">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="token" t-att-value="access.token"/>
                <t t-foreach="evaluations" t-as="evaluation">
                    <t t-set="can_edit" t-value="evaluation.id in editable_ids"/>
                    <div class="card">
                        <h2 style="margin-top:0;font-size:1.1rem;">
                            <t t-esc="evaluation.employee_id.name"/>
                            <span class="badge"><t t-esc="evaluation.date_start"/> – <t t-esc="evaluation.date_end"/></span>
                            <t t-if="not can_edit">
                                <span class="badge">View only</span>
                            </t>
                        </h2>
                        <table>
                            <thead>
                                <tr>
                                    <th>Criteria</th>
                                    <th>Description</th>
                                    <th>Max</th>
                                    <th>Your score</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="evaluation.score_line_ids.filtered(lambda line: line.user_id == access.user_id)" t-as="line">
                                    <tr>
                                        <td t-esc="line.criteria_id.name"/>
                                        <td t-esc="line.criteria_id.description or ''"/>
                                        <td t-esc="line.criteria_id.max_score"/>
                                        <td>
                                            <t t-if="can_edit">
                                                <input type="number" step="0.01" min="0"
                                                    t-att-max="line.criteria_id.max_score"
                                                    t-att-name="'score_%s' % line.id"
                                                    t-att-value="line.score"/>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="line.score"/>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                <t t-if="editable_ids">
                    <button type="submit" class="btn">Save scores</button>
                </t>
            </form>
        </t>
    </template>

    <template id="portal_score_thank_you" name="KPI Score - Thank You">
        <t t-call="sygmetiv_kpi.portal_score_page">
            <div class="card">
                <h1>Scores saved</h1>
                <p>Your KPI scores have been recorded.</p>
            </div>
        </t>
    </template>
</odoo>
