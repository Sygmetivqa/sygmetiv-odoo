<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_kpi_evaluation_list" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.list</field>
        <field name="model">syg.kpi.evaluation</field>
        <field name="arch" type="xml">
            <list string="KPI Evaluations" create="0">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="evaluation_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="net_score"/>
                <field name="status_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_syg_kpi_evaluation_form" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.form</field>
        <field name="model">syg.kpi.evaluation</field>
        <field name="arch" type="xml">
            <form string="KPI Evaluation" create="0">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft' or config_id" groups="sygmetiv_kpi.group_kpi_manager"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state == 'draft' or config_id" groups="sygmetiv_kpi.group_kpi_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="evaluation_type" readonly="state != 'draft'"/>
                            <field name="is_manager" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                            <field name="grace_days" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                            <field name="net_score" readonly="1"/>
                            <field name="max_score" readonly="1"/>
                            <field name="status_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluators" invisible="state != 'draft'">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="criteria_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scores" invisible="state == 'draft'">
                            <field name="score_line_ids" readonly="state == 'done'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="user_id" readonly="1"/>
                                    <field name="criteria_id" readonly="1"/>
                                    <field name="max_score" readonly="1"/>
                                    <field name="can_edit_score" column_invisible="1"/>
                                    <field name="score" readonly="not can_edit_score"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_syg_kpi_evaluation_search" model="ir.ui.view">
        <field name="name">syg.kpi.evaluation.search</field>
        <field name="model">syg.kpi.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="evaluation_type"/>
                <filter string="My evaluations" name="mine" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="To score" name="to_score" domain="[('line_ids.user_id', '=', uid), ('state', '=', 'submitted')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <group>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'evaluation_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_syg_kpi_evaluation" model="ir.actions.act_window">
        <field name="name">KPI Evaluations</field>
        <field name="res_model">syg.kpi.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_score': 1, 'create': False}</field>
    </record>

    <record id="action_syg_kpi_evaluation_mine" model="ir.actions.act_window">
        <field name="name">My Evaluation</field>
        <field name="res_model">syg.kpi.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
