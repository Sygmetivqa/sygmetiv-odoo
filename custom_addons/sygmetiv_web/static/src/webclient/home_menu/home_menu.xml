<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="sygmetiv_web.HomeMenu">
        <div class="o_home_menu h-100 w-100 overflow-auto d-flex flex-column align-items-center">
            <div class="o_home_menu_content">
                <div class="o_home_menu_search d-flex justify-content-center">
                    <input
                        t-ref="input"
                        type="search"
                        class="form-control form-control-lg o_home_menu_search_input"
                        placeholder="Search apps..."
                        t-model="state.query"
                    />
                </div>
                <div t-if="displayedApps.length" class="o_apps user-select-none" role="listbox">
                    <a
                        t-foreach="displayedApps"
                        t-as="app"
                        t-key="app.id"
                        class="o_app o_menuitem"
                        t-att-class="{ o_focused: state.focusedIndex === app_index }"
                        t-att-data-menu-xmlid="app.xmlid"
                        t-att-href="app.href"
                        t-on-click.prevent="() => this.openApp(app)"
                    >
                        <img
                            t-if="app.webIconData"
                            class="o_app_icon rounded-3"
                            t-att-src="app.webIconData"
                            t-att-alt="app.label"
                        />
                        <div
                            t-else=""
                            class="o_app_icon rounded-3 d-flex justify-content-center align-items-center"
                            t-attf-style="background-color: {{app.webIcon and app.webIcon.backgroundColor or '#714B67'}};"
                        >
                            <i
                                t-attf-class="{{app.webIcon and app.webIcon.iconClass or 'fa fa-th-large'}}"
                                t-attf-style="color: {{app.webIcon and app.webIcon.color or '#ffffff'}};"
                            />
                        </div>
                        <div class="o_caption text-center text-truncate" t-esc="app.label"/>
                    </a>
                </div>
                <div t-else="" class="o_no_result text-center text-muted py-5">
                    No apps found
                </div>
            </div>
        </div>
    </t>
</templates>
