<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_live_checklist_list" model="ir.ui.view">
        <field name="name">syg.live.checklist.item.list</field>
        <field name="model">syg.live.checklist.item</field>
        <field name="arch" type="xml">
            <list string="Live Checklist" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="mandatory"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_syg_live_checklist_form" model="ir.ui.view">
        <field name="name">syg.live.checklist.item.form</field>
        <field name="model">syg.live.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="mandatory"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_syg_live_checklist" model="ir.actions.act_window">
        <field name="name">Live Checklist</field>
        <field name="res_model">syg.live.checklist.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a go-live checklist item</p>
            <p>These items are loaded into the Go Live popup on a project. Mandatory items must be ticked before the project can go live.</p>
        </field>
    </record>
</odoo>
