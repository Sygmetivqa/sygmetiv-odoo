<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_credential_list" model="ir.ui.view">
        <field name="name">syg.credential.list</field>
        <field name="model">syg.credential</field>
        <field name="arch" type="xml">
            <list string="Credentials">
                <field name="name"/>
                <field name="username"/>
                <field name="url"/>
                <field name="project_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="allowed_user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_syg_credential_form" model="ir.ui.view">
        <field name="name">syg.credential.form</field>
        <field name="model">syg.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Server, application or account"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="username"/>
                            <field name="password" password="True"/>
                        </group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="allowed_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <field name="note" placeholder="Where this login is used"/>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_syg_credential_search" model="ir.ui.view">
        <field name="name">syg.credential.search</field>
        <field name="model">syg.credential</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="username"/>
                <field name="url"/>
                <field name="project_id"/>
                <field name="user_ids"/>
                <field name="allowed_user_ids"/>
                <filter string="My Credentials" name="my_credentials" domain="['|', ('user_ids', 'in', uid), ('allowed_user_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_syg_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">syg.credential</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_credentials': 1}</field>
    </record>
</odoo>
