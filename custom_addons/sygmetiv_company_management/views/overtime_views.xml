<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_overtime_list" model="ir.ui.view">
        <field name="name">syg.overtime.request.list</field>
        <field name="model">syg.overtime.request</field>
        <field name="arch" type="xml">
            <list string="Overtime" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="hours"/>
                <field name="project_id" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'approved'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_syg_overtime_form" model="ir.ui.view">
        <field name="name">syg.overtime.request.form</field>
        <field name="model">syg.overtime.request</field>
        <field name="arch" type="xml">
            <form string="Overtime Request">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'" groups="sygmetiv_company_management.group_company_manager"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'" groups="sygmetiv_company_management.group_company_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state not in ('rejected', 'approved')" groups="sygmetiv_company_management.group_company_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="hours"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="task_id" options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_syg_overtime_search" model="ir.ui.view">
        <field name="name">syg.overtime.request.search</field>
        <field name="model">syg.overtime.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="submitted" string="To Approve" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="my" string="My Overtime" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_syg_overtime" model="ir.actions.act_window">
        <field name="name">Overtime</field>
        <field name="res_model">syg.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my': 1}</field>
    </record>

    <record id="action_syg_overtime_to_approve" model="ir.actions.act_window">
        <field name="name">Overtime to Approve</field>
        <field name="res_model">syg.overtime.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'submitted')]</field>
    </record>
</odoo>
