<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_payslip_generate_wizard" model="ir.ui.view">
        <field name="name">syg.payslip.generate.wizard.form</field>
        <field name="model">syg.payslip.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Payslips">
                <group>
                    <field name="company_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="employee_ids" widget="many2many_tags" placeholder="Leave empty to include all employees" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_syg_payslip_generate" model="ir.actions.act_window">
        <field name="name">Generate Payslips</field>
        <field name="res_model">syg.payslip.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('group_company_manager'))]"/>
    </record>
</odoo>
