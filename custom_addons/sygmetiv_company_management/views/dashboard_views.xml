<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_workplace_dashboard_form" model="ir.ui.view">
        <field name="name">syg.workplace.dashboard.form</field>
        <field name="model">syg.workplace.dashboard</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <form string="Manager Dashboard" create="0" delete="0" class="o_syg_dashboard o_syg_dashboard_manager">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_manager" invisible="1"/>
                    <field name="employee_id" invisible="1"/>
                    <field name="period_end" invisible="1"/>
                    <field name="name" invisible="1"/>

                    <div class="o_syg_dash_hero">
                        <div class="o_syg_dash_hero_copy">
                            <div class="o_syg_dash_kicker">Sygmetiv · Manager</div>
                            <h1><field name="welcome_label" nolabel="1" readonly="1"/></h1>
                            <div class="o_syg_dash_subtitle">
                                <field name="role_label" nolabel="1" readonly="1"/>
                                · Projects, profit and team management
                            </div>
                        </div>
                        <div class="o_syg_dash_hero_actions">
                            <div class="o_syg_period_pill">
                                <i class="fa fa-calendar"/>
                                <field name="period_start" widget="daterange" options="{'end_date_field': 'period_end'}" nolabel="1"/>
                            </div>
                            <button name="action_open_employee_dashboard" type="object" string="Dashboard" class="btn btn-light o_syg_btn_ghost"/>
                            <button name="action_refresh" type="object" string="Refresh" class="btn btn-light o_syg_btn_ghost"/>
                            <button name="action_assign_task" type="object" string="Assign Task" class="btn btn-primary" groups="sygmetiv_company_management.group_syg_project_lead"/>
                            <button name="action_generate_payslips" type="object" string="Generate Payslips" class="btn btn-primary" groups="sygmetiv_company_management.group_syg_executive"/>
                        </div>
                    </div>

                    <div class="o_syg_dash_layout">
                        <div class="o_syg_dash_main">
                            <div class="o_syg_section_title">Team overview</div>
                            <div class="o_syg_kpi_grid o_syg_kpi_grid_money">
                                <button name="action_departments" type="object" class="o_syg_kpi_card o_syg_accent_violet">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-sitemap"/></span>
                                        <span class="o_syg_kpi_label">Departments</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_departments" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_employees" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-users"/></span>
                                        <span class="o_syg_kpi_label">Employees</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_employees" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_team" type="object" class="o_syg_kpi_card o_syg_accent_sky">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-user"/></span>
                                        <span class="o_syg_kpi_label">Direct Reports</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_team" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_on_leave" type="object" class="o_syg_kpi_card o_syg_accent_amber">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-plane"/></span>
                                        <span class="o_syg_kpi_label">On Leave</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_on_leave" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_team_timesheets" type="object" class="o_syg_kpi_card o_syg_accent_green">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-clock-o"/></span>
                                        <span class="o_syg_kpi_label">Team Timesheets</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_team_timesheet" nolabel="1" readonly="1"/></div>
                                </button>
                            </div>
                            <div class="o_syg_kpi_grid o_syg_kpi_grid_money">
                                <button name="action_task_requests_pending" type="object" class="o_syg_kpi_card o_syg_accent_amber">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-pencil-square-o"/></span>
                                        <span class="o_syg_kpi_label">Task requests to convert</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_task_requests_pending" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_overtime_to_approve" type="object" class="o_syg_kpi_card o_syg_accent_amber" groups="sygmetiv_attendance.group_syg_overtime">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-hourglass-half"/></span>
                                        <span class="o_syg_kpi_label">Overtime to Approve</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_ot_approve" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="o_syg_kpi_card o_syg_accent_rose o_syg_kpi_static" groups="sygmetiv_attendance.group_syg_overtime">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-clock-o"/></span>
                                        <span class="o_syg_kpi_label">Approved Overtime</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_team_overtime" nolabel="1" readonly="1"/></div>
                                </div>
                                <button name="action_reviews_pending" type="object" class="o_syg_kpi_card o_syg_accent_sky">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-comments"/></span>
                                        <span class="o_syg_kpi_label">Pending Reviews</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_reviews" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_payslips" type="object" class="o_syg_kpi_card o_syg_accent_rose">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-file-text-o"/></span>
                                        <span class="o_syg_kpi_label">Payslips to Process</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_payslips" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_projects" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-folder-open"/></span>
                                        <span class="o_syg_kpi_label">Projects</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_projects" nolabel="1" readonly="1"/></div>
                                </button>
                            </div>

                            <div class="o_syg_section_title">Projects</div>
                            <div class="o_syg_kpi_grid o_syg_kpi_grid_money">
                                <button name="action_projects" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-folder-open"/></span>
                                        <span class="o_syg_kpi_label">Projects</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_projects" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_open_company_tasks" type="object" class="o_syg_kpi_card o_syg_accent_violet">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-check-square-o"/></span>
                                        <span class="o_syg_kpi_label">Open Tasks</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_open_tasks_company" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_amc_projects" type="object" class="o_syg_kpi_card o_syg_accent_sky">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-certificate"/></span>
                                        <span class="o_syg_kpi_label">AMC Projects</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_amc_projects" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_at_risk_projects" type="object" class="o_syg_kpi_card o_syg_accent_rose">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-exclamation-triangle"/></span>
                                        <span class="o_syg_kpi_label">At Risk</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_at_risk" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_team_timesheets" type="object" class="o_syg_kpi_card o_syg_accent_green">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-clock-o"/></span>
                                        <span class="o_syg_kpi_label">Project Hours</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_team_timesheet" nolabel="1" readonly="1"/></div>
                                </button>
                            </div>

                            <div class="o_syg_section_title">Profit</div>
                            <div class="o_syg_kpi_grid o_syg_kpi_grid_money">
                                <div class="o_syg_kpi_card o_syg_accent_green o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-arrow-up"/></span>
                                        <span class="o_syg_kpi_label">Income</span>
                                    </div>
                                    <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_income" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="o_syg_kpi_card o_syg_accent_rose o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-arrow-down"/></span>
                                        <span class="o_syg_kpi_label">Expense</span>
                                    </div>
                                    <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_expense_amt" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="o_syg_kpi_card o_syg_accent_violet o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-line-chart"/></span>
                                        <span class="o_syg_kpi_label">Profit</span>
                                    </div>
                                    <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_profit" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="o_syg_kpi_card o_syg_accent_sky o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-inbox"/></span>
                                        <span class="o_syg_kpi_label">Receivable</span>
                                    </div>
                                    <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_receivable" nolabel="1" readonly="1"/></div>
                                </div>
                                <div class="o_syg_kpi_card o_syg_accent_amber o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-credit-card"/></span>
                                        <span class="o_syg_kpi_label">Payable</span>
                                    </div>
                                    <div class="o_syg_kpi_value o_syg_kpi_money"><field name="d_payable" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>
                            <div class="o_syg_dash_links" groups="account.group_account_readonly">
                                <button name="action_invoice_analysis" type="object" string="Invoice Analysis" class="btn btn-link"/>
                                <button name="action_analytic_report" type="object" string="Analytic Report" class="btn btn-link"/>
                            </div>

                            <div class="o_syg_section_title">Management graphs</div>
                            <div class="o_syg_chart_grid">
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Hours by project</div>
                                    <field name="graph_projects" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Income, expense and profit</div>
                                    <field name="graph_profit" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Headcount by department</div>
                                    <field name="graph_headcount" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_syg_chart_grid">
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Timesheet hours by department</div>
                                    <field name="graph_timesheet" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card" groups="sygmetiv_attendance.group_syg_overtime">
                                    <div class="o_syg_kpi_label">Approved overtime this period</div>
                                    <field name="graph_overtime" widget="syg_dashboard_graph" options="{'graph_type': 'line'}" nolabel="1"/>
                                </div>
                            </div>

                        </div>
                        <aside class="o_syg_dash_side">
                            <div class="o_syg_announce_panel">
                                <div class="o_syg_announce_head">
                                    <div>
                                        <div class="o_syg_dash_kicker">Live board</div>
                                        <div class="o_syg_section_title">Announcements</div>
                                    </div>
                                    <button name="action_announcements" type="object" string="See all" class="btn btn-link"/>
                                </div>
                                <field name="announcement_board" nolabel="1" readonly="1"/>
                            </div>
                        </aside>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_syg_employee_dashboard_form" model="ir.ui.view">
        <field name="name">syg.employee.dashboard.form</field>
        <field name="model">syg.workplace.dashboard</field>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <form string="Employee Dashboard" create="0" delete="0" class="o_syg_dashboard o_syg_dashboard_employee">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_manager" invisible="1"/>
                    <field name="show_manager_dashboard" invisible="1"/>
                    <field name="employee_id" invisible="1"/>
                    <field name="period_end" invisible="1"/>
                    <field name="name" invisible="1"/>

                    <div class="o_syg_dash_hero">
                        <div class="o_syg_dash_hero_copy o_syg_profile">
                            <field name="employee_image" widget="image" class="o_syg_avatar" options="{'size': [88, 88], 'zoom': false}" readonly="1" nolabel="1"/>
                            <div>
                                <div class="o_syg_dash_kicker">Sygmetiv · Workplace</div>
                                <h1><field name="welcome_label" nolabel="1" readonly="1"/></h1>
                                <div class="o_syg_dash_subtitle">
                                    <field name="employee_job" nolabel="1" readonly="1"/>
                                    <span invisible="not employee_department"> · </span>
                                    <field name="employee_department" nolabel="1" readonly="1"/>
                                </div>
                                <div class="o_syg_profile_facts">
                                    <span><i class="fa fa-briefcase"/> Joined <field name="d_join_date" nolabel="1" readonly="1"/></span>
                                    <span><i class="fa fa-birthday-cake"/> Born <field name="d_birth_date" nolabel="1" readonly="1"/></span>
                                    <span><i class="fa fa-venus-mars"/> <field name="d_gender" nolabel="1" readonly="1"/></span>
                                </div>
                            </div>
                        </div>
                        <div class="o_syg_dash_hero_actions">
                            <div class="o_syg_period_pill">
                                <i class="fa fa-calendar"/>
                                <field name="period_start" widget="daterange" options="{'end_date_field': 'period_end'}" nolabel="1"/>
                            </div>
                            <button name="action_open_manager_dashboard" type="object" string="Manager Dashboard" class="btn btn-light o_syg_btn_ghost" invisible="not show_manager_dashboard"/>
                            <button name="action_refresh" type="object" string="Refresh" class="btn btn-light o_syg_btn_ghost"/>
                        </div>
                    </div>

                    <div class="o_syg_dash_layout">
                        <div class="o_syg_dash_main">
                            <div class="o_syg_section_title">Time and attendance</div>
                            <div class="o_syg_kpi_grid">
                                <button name="action_my_leaves" type="object" class="o_syg_kpi_card o_syg_accent_sky">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-plane"/></span>
                                        <span class="o_syg_kpi_label">Leave Taken (days)</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_leave_days" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_leaves" type="object" class="o_syg_kpi_card o_syg_accent_amber">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-hourglass-half"/></span>
                                        <span class="o_syg_kpi_label">Leave Requests</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_leave" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_leaves" type="object" class="o_syg_kpi_card o_syg_accent_rose">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-clock-o"/></span>
                                        <span class="o_syg_kpi_label">Leave Pending</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_leave_pending" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_attendance" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-sign-in"/></span>
                                        <span class="o_syg_kpi_label">Attendance Hours</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_attendance" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_attendance" type="object" class="o_syg_kpi_card o_syg_accent_green">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-calendar-check-o"/></span>
                                        <span class="o_syg_kpi_label">Days Present</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_attendance_days" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="o_syg_kpi_card o_syg_accent_violet o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-user"/></span>
                                        <span class="o_syg_kpi_label">Today</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_checked_in" nolabel="1" readonly="1"/></div>
                                </div>
                                <button name="action_my_timesheets" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-clock-o"/></span>
                                        <span class="o_syg_kpi_label">Timesheet Hours</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_timesheet" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_overtime" type="object" class="o_syg_kpi_card o_syg_accent_amber" groups="sygmetiv_attendance.group_syg_overtime">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-plus"/></span>
                                        <span class="o_syg_kpi_label">Overtime Hours</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_overtime" nolabel="1" readonly="1"/></div>
                                </button>
                            </div>
                            <div class="o_syg_section_title">My work</div>
                            <div class="o_syg_kpi_grid">
                                <button name="action_task_requests" type="object" class="o_syg_kpi_card o_syg_accent_teal">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-pencil-square-o"/></span>
                                        <span class="o_syg_kpi_label">Task Requests</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_task_requests" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_task_requests_pending" type="object" class="o_syg_kpi_card o_syg_accent_amber">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-hourglass-half"/></span>
                                        <span class="o_syg_kpi_label">Waiting for task</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_task_requests_pending" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_tasks" type="object" class="o_syg_kpi_card o_syg_accent_violet">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-check-square-o"/></span>
                                        <span class="o_syg_kpi_label">Open Tasks</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_open_tasks" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="o_syg_kpi_card o_syg_accent_violet o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-list"/></span>
                                        <span class="o_syg_kpi_label">My Tasks</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_tasks" nolabel="1" readonly="1"/></div>
                                </div>
                                <button name="action_my_expenses" type="object" class="o_syg_kpi_card o_syg_accent_rose" groups="sygmetiv_company_management.group_company_manager">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-credit-card"/></span>
                                        <span class="o_syg_kpi_label">Expenses</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_expense" nolabel="1" readonly="1"/></div>
                                </button>
                                <button name="action_my_goals" type="object" class="o_syg_kpi_card o_syg_accent_green" groups="sygmetiv_company_management.group_company_manager">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-flag"/></span>
                                        <span class="o_syg_kpi_label">Open Goals</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_goals" nolabel="1" readonly="1"/></div>
                                </button>
                                <div class="o_syg_kpi_card o_syg_kpi_score o_syg_kpi_static">
                                    <div class="o_syg_kpi_top">
                                        <span class="o_syg_kpi_icon"><i class="fa fa-star"/></span>
                                        <span class="o_syg_kpi_label">Last Review Score</span>
                                    </div>
                                    <div class="o_syg_kpi_value"><field name="d_score" nolabel="1" readonly="1"/></div>
                                </div>
                            </div>

                            <div class="o_syg_section_title">My graphs</div>
                            <div class="o_syg_chart_grid">
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Timesheet hours</div>
                                    <field name="graph_my_timesheet" widget="syg_dashboard_graph" options="{'graph_type': 'line'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Attendance hours</div>
                                    <field name="graph_my_attendance" widget="syg_dashboard_graph" options="{'graph_type': 'line'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Leave taken by type</div>
                                    <field name="graph_my_leave" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_syg_chart_grid">
                                <div class="o_syg_chart_card">
                                    <div class="o_syg_kpi_label">Time snapshot</div>
                                    <field name="graph_my_activity" widget="syg_dashboard_graph" options="{'graph_type': 'bar'}" nolabel="1"/>
                                </div>
                                <div class="o_syg_chart_card" groups="sygmetiv_attendance.group_syg_overtime">
                                    <div class="o_syg_kpi_label">Approved overtime</div>
                                    <field name="graph_my_overtime" widget="syg_dashboard_graph" options="{'graph_type': 'line'}" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                        <aside class="o_syg_dash_side">
                            <div class="o_syg_announce_panel">
                                <div class="o_syg_announce_head">
                                    <div>
                                        <div class="o_syg_dash_kicker">Live board</div>
                                        <div class="o_syg_section_title">Announcements</div>
                                    </div>
                                    <button name="action_announcements" type="object" string="See all" class="btn btn-link"/>
                                </div>
                                <field name="announcement_board" nolabel="1" readonly="1"/>
                            </div>
                            <field name="leave_today_board" nolabel="1" readonly="1"/>
                        </aside>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_syg_employee_dashboard" model="ir.actions.server">
        <field name="name">Dashboard</field>
        <field name="model_id" ref="model_syg_workplace_dashboard"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(5, 0, 0)]"/>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="action_syg_workplace" model="ir.actions.server">
        <field name="name">Manager Dashboard</field>
        <field name="model_id" ref="model_syg_workplace_dashboard"/>
        <field name="state">code</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_syg_show_manager_dashboard')])]"/>
        <field name="code">action = model.action_open()</field>
    </record>
</odoo>
