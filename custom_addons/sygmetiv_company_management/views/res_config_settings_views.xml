<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_syg" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.syg.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Community Payroll" name="syg_payroll_settings">
                    <setting string="Overtime multiplier" help="Hourly overtime = (monthly wage / monthly hours) × multiplier.">
                        <field name="syg_overtime_multiplier"/>
                    </setting>
                    <setting string="Standard monthly hours" help="Hours used to convert monthly wage to an hourly rate.">
                        <field name="syg_monthly_hours"/>
                    </setting>
                    <setting string="Payroll journal" help="Miscellaneous journal used when confirming payslips.">
                        <field name="syg_payroll_journal_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Salary expense account">
                        <field name="syg_payroll_expense_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting string="Salary payable account">
                        <field name="syg_payroll_payable_account_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
