<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_task_assign_wizard" model="ir.ui.view">
        <field name="name">syg.task.assign.wizard.form</field>
        <field name="model">syg.task.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Task">
                <group>
                    <field name="project_id" options="{'no_create': True}"/>
                    <field name="name"/>
                    <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="date_deadline"/>
                    <field name="allocated_hours"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_syg_task_assign" model="ir.actions.act_window">
        <field name="name">Assign Task</field>
        <field name="res_model">syg.task.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('group_company_manager'))]"/>
    </record>
</odoo>
