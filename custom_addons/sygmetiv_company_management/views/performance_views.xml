<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_goal_list" model="ir.ui.view">
        <field name="name">syg.performance.goal.list</field>
        <field name="model">syg.performance.goal</field>
        <field name="arch" type="xml">
            <list string="Goals" editable="bottom">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="project_id" optional="show"/>
                <field name="deadline"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_syg_goal_form" model="ir.ui.view">
        <field name="name">syg.performance.goal.form</field>
        <field name="model">syg.performance.goal</field>
        <field name="arch" type="xml">
            <form string="Goal">
                <header>
                    <button name="action_done" type="object" string="Mark Achieved" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_id" options="{'no_create': True}"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                            <field name="review_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="task_id" options="{'no_create': True}"/>
                            <field name="deadline"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Goal description..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_syg_review_list" model="ir.ui.view">
        <field name="name">syg.performance.review.list</field>
        <field name="model">syg.performance.review</field>
        <field name="arch" type="xml">
            <list string="Reviews">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="overall_score"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_syg_review_form" model="ir.ui.view">
        <field name="name">syg.performance.review.form</field>
        <field name="model">syg.performance.review</field>
        <field name="arch" type="xml">
            <form string="Performance Review">
                <header>
                    <button name="action_submit" type="object" string="Submit Self Assessment" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_manager_review" type="object" string="Manager Review" class="btn-primary" invisible="state != 'submitted'" groups="sygmetiv_company_management.group_company_manager"/>
                    <button name="action_done" type="object" string="Complete" class="btn-primary" invisible="state != 'reviewed'" groups="sygmetiv_company_management.group_company_manager"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" groups="sygmetiv_company_management.group_company_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed,done"/>
                </header>
                <sheet>
                    <field name="is_manager" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft' and not is_manager"/>
                            <field name="employee_id" options="{'no_create': True}" readonly="not is_manager"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft' and not is_manager"/>
                            <field name="date_end" readonly="state != 'draft' and not is_manager"/>
                            <field name="overall_score"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Period activity">
                        <field name="timesheet_hours"/>
                        <field name="overtime_hours" groups="sygmetiv_attendance.group_syg_overtime"/>
                        <field name="task_count"/>
                    </group>
                    <group string="Scores (1-5)">
                        <group>
                            <field name="quality_score" readonly="state != 'draft' and not is_manager"/>
                            <field name="delivery_score" readonly="state != 'draft' and not is_manager"/>
                        </group>
                        <group>
                            <field name="teamwork_score" readonly="state != 'draft' and not is_manager"/>
                            <field name="timesheet_score" readonly="state != 'draft' and not is_manager"/>
                        </group>
                    </group>
                    <group>
                        <field name="employee_comment" placeholder="Employee comments..." readonly="state != 'draft' and not is_manager"/>
                        <field name="manager_comment" placeholder="Manager comments..." readonly="not is_manager"/>
                    </group>
                    <field name="goal_ids" readonly="state != 'draft' and not is_manager">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="deadline"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_syg_goal" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="res_model">syg.performance.goal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_syg_review" model="ir.actions.act_window">
        <field name="name">Performance Reviews</field>
        <field name="res_model">syg.performance.review</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_syg_review_mine" model="ir.actions.act_window">
        <field name="name">My Review</field>
        <field name="res_model">syg.performance.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
    </record>
</odoo>
