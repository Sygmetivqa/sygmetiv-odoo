<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_syg_company" model="ir.module.category">
        <field name="name">Company Management</field>
        <field name="sequence">28</field>
    </record>

    <record id="privilege_syg_company" model="res.groups.privilege">
        <field name="name">Company Management</field>
        <field name="category_id" ref="module_category_syg_company"/>
    </record>

    <record id="privilege_syg_manager_dashboard_view" model="res.groups.privilege">
        <field name="name">Manager Dashboard</field>
        <field name="sequence">30</field>
        <field name="placeholder">No</field>
        <field name="description">Open the manager dashboard from the Sygmetiv Dashboard.</field>
        <field name="category_id" ref="module_category_syg_company"/>
    </record>

    <record id="group_syg_show_manager_dashboard" model="res.groups">
        <field name="name">Show</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_syg_manager_dashboard_view"/>
        <field name="comment">Show the Manager Dashboard button on the Sygmetiv Dashboard.</field>
    </record>

    <record id="group_syg_assign_task" model="res.groups">
        <field name="name">Assign Task</field>
        <field name="comment">Open the Assign Task wizard and assign project tasks.</field>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_syg_generate_payslip" model="res.groups">
        <field name="name">Generate Payslips</field>
        <field name="comment">Generate and compute employee payslips.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_company_user" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_syg_company"/>
        <field name="comment">Own records only: employee profile, tasks, time off, overtime, timesheets and performance.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sygmetiv_hr.group_announcement_user')), (4, ref('hr_timesheet.group_hr_timesheet_user'))]"/>
    </record>

    <record id="group_company_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_syg_company"/>
        <field name="comment">All company records and every Sygmetiv menu.</field>
        <field name="implied_ids" eval="[(4, ref('group_company_user')), (4, ref('sygmetiv_hr.group_announcement_manager')), (4, ref('hr.group_hr_manager')), (4, ref('hr_recruitment.group_hr_recruitment_user')), (4, ref('hr_attendance.group_hr_attendance_user')), (4, ref('project.group_project_manager'))]"/>
    </record>

    <record id="group_syg_project_lead" model="res.groups">
        <field name="name">Project Lead</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_syg_company"/>
        <field name="comment">Company operations: all employees, managers, projects, tasks and assignments.</field>
        <field name="implied_ids" eval="[(4, ref('group_company_manager')), (4, ref('project.group_project_manager')), (4, ref('group_syg_assign_task'))]"/>
    </record>

    <record id="group_syg_executive" model="res.groups">
        <field name="name">Business Executive</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_syg_company"/>
        <field name="comment">Whole company flows including payroll and accounting reports.</field>
        <field name="implied_ids" eval="[(4, ref('group_syg_project_lead')), (4, ref('group_syg_generate_payslip')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="group_syg_ceo" model="res.groups">
        <field name="name">CEO</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_syg_company"/>
        <field name="comment">Full company access including configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_syg_executive')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_hr_employee_own" model="ir.rule">
        <field name="name">Sygmetiv Employee: own employee record</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('id', 'in', list(filter(None, [user.employee_id.id, user.employee_id.parent_id.id, user.employee_id.coach_id.id])))]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_hr_employee_team" model="ir.rule">
        <field name="name">Sygmetiv Manager: team employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_hr_employee_company" model="ir.rule">
        <field name="name">Sygmetiv Project Lead+: all employees</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_syg_project_lead'))]"/>
    </record>

    <record id="rule_overtime_own" model="ir.rule">
        <field name="name">Overtime: own</field>
        <field name="model_id" ref="model_syg_overtime_request"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_overtime_team" model="ir.rule">
        <field name="name">Overtime: team</field>
        <field name="model_id" ref="model_syg_overtime_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_overtime_company" model="ir.rule">
        <field name="name">Overtime: company</field>
        <field name="model_id" ref="model_syg_overtime_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_syg_project_lead'))]"/>
    </record>

    <record id="rule_payslip_own" model="ir.rule">
        <field name="name">Payslip: own</field>
        <field name="model_id" ref="model_syg_payslip"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_payslip_team" model="ir.rule">
        <field name="name">Payslip: team</field>
        <field name="model_id" ref="model_syg_payslip"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_payslip_company" model="ir.rule">
        <field name="name">Payslip: company</field>
        <field name="model_id" ref="model_syg_payslip"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_syg_executive'))]"/>
    </record>

    <record id="rule_review_own" model="ir.rule">
        <field name="name">Review: own</field>
        <field name="model_id" ref="model_syg_performance_review"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_review_team" model="ir.rule">
        <field name="name">Review: team</field>
        <field name="model_id" ref="model_syg_performance_review"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_review_company" model="ir.rule">
        <field name="name">Review: company</field>
        <field name="model_id" ref="model_syg_performance_review"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_syg_project_lead'))]"/>
    </record>

    <record id="rule_goal_own" model="ir.rule">
        <field name="name">Goal: own</field>
        <field name="model_id" ref="model_syg_performance_goal"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_goal_team" model="ir.rule">
        <field name="name">Goal: team</field>
        <field name="model_id" ref="model_syg_performance_goal"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_goal_company" model="ir.rule">
        <field name="name">Goal: company</field>
        <field name="model_id" ref="model_syg_performance_goal"/>
        <field name="groups" eval="[(4, ref('group_syg_project_lead'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_timesheet_team" model="ir.rule">
        <field name="name">Timesheet: manager team</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="domain_force">[('project_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>

    <record id="rule_task_request_own" model="ir.rule">
        <field name="name">Task request: own</field>
        <field name="model_id" ref="model_syg_task_request"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_task_request_team" model="ir.rule">
        <field name="name">Task request: team</field>
        <field name="model_id" ref="model_syg_task_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_task_request_company" model="ir.rule">
        <field name="name">Task request: company</field>
        <field name="model_id" ref="model_syg_task_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_syg_project_lead'))]"/>
    </record>

    <record id="rule_project_document_own" model="ir.rule">
        <field name="name">Project document: own</field>
        <field name="model_id" ref="model_syg_project_document"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_project_document_manager" model="ir.rule">
        <field name="name">Project document: manager</field>
        <field name="model_id" ref="model_syg_project_document"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_project_note_own" model="ir.rule">
        <field name="name">Project note: own</field>
        <field name="model_id" ref="model_syg_project_note"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_company_user'))]"/>
    </record>
    <record id="rule_syg_credential_visibility" model="ir.rule">
        <field name="name">Credential: users and allowed users</field>
        <field name="model_id" ref="model_syg_credential"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('user_ids', 'in', user.id), ('allowed_user_ids', 'in', user.id)]</field>
    </record>
    <record id="rule_project_note_manager" model="ir.rule">
        <field name="name">Project note: manager</field>
        <field name="model_id" ref="model_syg_project_note"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>

    <!--
        Standard apps also grant broad group rules. Those combine with OR, so an
        employee rule alone cannot hide other people's rows. These global rules
        AND that result: company employees see their own rows, managers see all,
        and users outside Company Management are unchanged.
    -->
    <record id="rule_syg_employee_public_scope" model="ir.rule">
        <field name="name">Sygmetiv: employee directory scope</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or [('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_task_scope" model="ir.rule">
        <field name="name">Sygmetiv: task scope</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or ['|', '|', ('user_ids', 'in', user.id), ('create_uid', '=', user.id), ('syg_task_request_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_task_manager" model="ir.rule">
        <field name="name">Sygmetiv: manager tasks</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_syg_version_scope" model="ir.rule">
        <field name="name">Sygmetiv: employee version scope</field>
        <field name="model_id" ref="hr.model_hr_version"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or ['|', ('employee_id.user_id', '=', user.id), ('employee_id', 'in', list(filter(None, [user.employee_id.id, user.employee_id.parent_id.id, user.employee_id.coach_id.id])))]</field>
    </record>
    <record id="rule_syg_attendance_overtime_line_scope" model="ir.rule">
        <field name="name">Sygmetiv: attendance extra hours scope</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or [('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_leave_scope" model="ir.rule">
        <field name="name">Sygmetiv: time off scope</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or [('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_leave_manager" model="ir.rule">
        <field name="name">Sygmetiv: manager time off</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_syg_attendance_scope" model="ir.rule">
        <field name="name">Sygmetiv: attendance scope</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or [('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_attendance_manager" model="ir.rule">
        <field name="name">Sygmetiv: manager attendance</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
    <record id="rule_syg_timesheet_scope" model="ir.rule">
        <field name="name">Sygmetiv: timesheet scope</field>
        <field name="model_id" ref="analytic.model_account_analytic_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or ['|', ('project_id', '=', False), '|', ('user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_expense_scope" model="ir.rule">
        <field name="name">Sygmetiv: expense scope</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">(user.has_group('sygmetiv_company_management.group_company_manager') or not user.has_group('sygmetiv_company_management.group_company_user')) and [(1, '=', 1)] or [('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_syg_expense_manager" model="ir.rule">
        <field name="name">Sygmetiv: manager expenses</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_company_manager'))]"/>
    </record>
</odoo>
