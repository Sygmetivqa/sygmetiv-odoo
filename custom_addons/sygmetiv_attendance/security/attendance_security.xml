<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_syg_overtime" model="res.groups.privilege">
        <field name="name">Overtime</field>
        <field name="sequence">25</field>
        <field name="placeholder">Hidden</field>
        <field name="description">Show overtime menus, dashboard figures, payslip overtime and attendance extra hours.</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_syg_overtime" model="res.groups">
        <field name="name">Show</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_syg_overtime"/>
        <field name="comment">Show overtime across attendance, the workplace dashboard, payroll and performance.</field>
    </record>

    <record id="rule_syg_attendance_geofence_company" model="ir.rule">
        <field name="name">Attendance location: multi-company</field>
        <field name="model_id" ref="model_syg_attendance_geofence"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
