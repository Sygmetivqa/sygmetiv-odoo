        <field name="name">hr.attendance.list.syg.hide.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree_management"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_approve_overtime']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_refuse_overtime']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//list/button[@name='action_approve_overtime']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//list/button[@name='action_refuse_overtime']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//field[@name='validated_overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_employee_simple_tree_syg" model="ir.ui.view">
        <field name="name">hr.attendance.list.syg.employee.hide.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_employee_simple_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validated_overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//field[@name='overtime_status']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_view_graph_syg" model="ir.ui.view">
        <field name="name">hr.attendance.graph.syg.hide.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_graph"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_view_pivot_syg" model="ir.ui.view">
        <field name="name">hr.attendance.pivot.syg.hide.overtime</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
            <xpath expr="//field[@name='validated_overtime_hours']" position="attributes">
                <attribute name="groups">sygmetiv_attendance.group_syg_overtime</attribute>
            </xpath>
        </field>
    </record>
</odoo>
