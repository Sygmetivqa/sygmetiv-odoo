<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_syg_attendance_geofence_list" model="ir.ui.view">
        <field name="name">syg.attendance.geofence.list</field>
        <field name="model">syg.attendance.geofence</field>
        <field name="arch" type="xml">
            <list string="Attendance Locations">
                <field name="name"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="radius"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="employee_ids" widget="many2many_tags" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_syg_attendance_geofence_form" model="ir.ui.view">
        <field name="name">syg.attendance.geofence.form</field>
        <field name="model">syg.attendance.geofence</field>
        <field name="arch" type="xml">
            <form string="Attendance Location">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Doha Office"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="radius"/>
                        </group>
                        <group>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group string="Employees">
                        <field name="employee_ids" widget="syg_many2many_links" nolabel="1" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_syg_attendance_geofence_search" model="ir.ui.view">
        <field name="name">syg.attendance.geofence.search</field>
        <field name="model">syg.attendance.geofence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_syg_attendance_geofence" model="ir.actions.act_window">
        <field name="name">Attendance Locations</field>
        <field name="res_model">syg.attendance.geofence</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a location employees can check in from</p>
            <p>Set the latitude, longitude and radius, then assign the employees who work there. Attendance check-in and check-out are matched against these locations.</p>
        </field>
    </record>
</odoo>
