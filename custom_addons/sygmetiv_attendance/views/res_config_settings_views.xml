<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_syg_geofence" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.syg.geofence</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']" position="inside">
                <setting string="Geofence" company_dependent="1"
                    help="Compare each check-in and check-out with the locations on the employee. Turn on Device and Location Tracking so GPS coordinates are collected. Block refuses systray and kiosk attendance outside those locations. Manual attendance is still recorded.">
                    <field name="syg_attendance_geofence_policy" class="w-75"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
