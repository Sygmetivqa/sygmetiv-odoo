<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_syg_mis" model="ir.actions.report">
        <field name="name">MIS Report</field>
        <field name="model">syg.mis.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sygmetiv_accounting.report_syg_mis_document</field>
        <field name="report_file">sygmetiv_accounting.report_syg_mis_document</field>
        <field name="print_report_name">'MIS - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_syg_mis_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_syg_mis_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-field="doc.name"/>
                        <div>
                            <strong>Company:</strong> <span t-field="doc.company_id"/>
                            &#160; <strong>Period:</strong>
                            <span t-field="doc.period_start"/> – <span t-field="doc.period_end"/>
                        </div>
                        <table class="table table-sm o_main_table mt-3">
                            <thead>
                                <tr>
                                    <th>Code</th>
                                    <th>Description</th>
                                    <th class="text-end">Previous</th>
                                    <th class="text-end">Debit</th>
                                    <th class="text-end">Credit</th>
                                    <t t-if="doc.show_aged">
                                        <th class="text-end">Not due</th>
                                        <th class="text-end">1-30</th>
                                        <th class="text-end">31-60</th>
                                        <th class="text-end">61-90</th>
                                        <th class="text-end">90+</th>
                                    </t>
                                    <th class="text-end">Balance</th>
                                    <th class="text-end">Variance</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr t-att-class="'fw-bold' if line.line_type != 'account' else None">
                                        <td><span t-field="line.code"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td class="text-end"><span t-field="line.previous"/></td>
                                        <td class="text-end"><span t-field="line.debit"/></td>
                                        <td class="text-end"><span t-field="line.credit"/></td>
                                        <t t-if="doc.show_aged">
                                            <td class="text-end"><span t-field="line.not_due"/></td>
                                            <td class="text-end"><span t-field="line.days_30"/></td>
                                            <td class="text-end"><span t-field="line.days_60"/></td>
                                            <td class="text-end"><span t-field="line.days_90"/></td>
                                            <td class="text-end"><span t-field="line.days_older"/></td>
                                        </t>
                                        <td class="text-end"><span t-field="line.balance"/></td>
                                        <td class="text-end"><span t-field="line.variance"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
