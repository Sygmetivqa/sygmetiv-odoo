<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_syg_announcement" model="ir.module.category">
        <field name="name">Announcements</field>
        <field name="sequence">29</field>
    </record>

    <record id="privilege_syg_announcement" model="res.groups.privilege">
        <field name="name">Announcements</field>
        <field name="category_id" ref="module_category_syg_announcement"/>
    </record>

    <record id="group_announcement_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_syg_announcement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read published announcements.</field>
    </record>

    <record id="group_announcement_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_syg_announcement"/>
        <field name="implied_ids" eval="[(4, ref('group_announcement_user'))]"/>
        <field name="comment">Create, publish and archive announcements.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_announcement_user" model="ir.rule">
        <field name="name">Announcements: published for employees</field>
        <field name="model_id" ref="model_syg_announcement"/>
        <field name="domain_force">[('state', '=', 'published'), ('audience', 'in', ('all', 'employee'))]</field>
        <field name="groups" eval="[(4, ref('group_announcement_user'))]"/>
    </record>
    <record id="rule_announcement_manager" model="ir.rule">
        <field name="name">Announcements: managers all</field>
        <field name="model_id" ref="model_syg_announcement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_announcement_manager'))]"/>
    </record>
    <record id="rule_announcement_company" model="ir.rule">
        <field name="name">Announcements: company</field>
        <field name="model_id" ref="model_syg_announcement"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
